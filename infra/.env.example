# ==============================================================
# CONFIGURACIÓN DE ENTORNO - VigIA
# ==============================================================
# Utilizar este archivo como plantilla para el entorno local y 
# para configurar las variables en producción (Ej: Railway).
# NUNCA commitear contraseñas reales de producción.
# ==============================================================

# --------------------------------------------------------------
# 1. Base de Datos (PostgreSQL / TimescaleDB)
# --------------------------------------------------------------
# En local: valores por defecto para iniciar el contenedor de DB.
POSTGRES_DB=vigia
POSTGRES_USER=vigia_user
POSTGRES_PASSWORD=insert_secure_password_here

# Usados por el Backend para conectarse a la DB.
# En Railway: usar las variables provistas por el plugin de Postgres 
# (ej: host interno, port, user, pass).
DB_HOST=db
DB_PORT=5432
DB_NAME=vigia
DB_USER=vigia_user
DB_PASSWORD=insert_secure_password_here

# --------------------------------------------------------------
# 2. RabbitMQ (Colas de Mensajería)
# --------------------------------------------------------------
# En local: rabbitmq
# En Railway: internal domain del servicio RabbitMQ.
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --------------------------------------------------------------
# 3. Servidor de Correos (SMTP)
# --------------------------------------------------------------
# En local: maildev/mailpit (puerto 1025)
# En Railway/Producción: credenciales de un SMTP real (SendGrid, AWS SES, Gmail, etc).
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USER=user
MAIL_PASSWORD=pass

# --------------------------------------------------------------
# 4. Microservicios de Machine Learning
# --------------------------------------------------------------
# Puertos para desarrollo local (host)
ML_CELO_PORT=8001
ML_SALUD_PORT=8002
ML_GEO_PORT=8003

# URLs de los microservicios (usados por el Backend Worker)
# En local: http://ml-celo:8001, etc.
# En Railway: URLs internas de Railway (ej: http://ml-celo.railway.internal:8001)
ML_CELO_URL=http://ml-celo:8001
ML_SALUD_URL=http://ml-salud:8002
ML_GEO_URL=http://ml-geo:8003

# --------------------------------------------------------------
# 5. Backend y Configuración General
# --------------------------------------------------------------
# Puertos expuestos en local
BACKEND_PORT=8080

# Perfil de Spring Boot (dev o prod)
SPRING_PROFILES_ACTIVE=dev

# Configuración de CORS para el Frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Zona Horaria
TZ=America/Argentina/Buenos_Aires
