# ==============================================================
# CONFIGURACIÓN DE ENTORNO - VigIA
# ==============================================================
# Utilizar este archivo como plantilla para el entorno local y 
# para configurar las variables en producción (Ej: Railway).
# NUNCA commitear contraseñas reales de producción.
# ==============================================================

# --------------------------------------------------------------
# 1. Base de Datos (PostgreSQL / TimescaleDB)
# --------------------------------------------------------------
# En local: valores por defecto para iniciar el contenedor de DB.
POSTGRES_DB=vigia
POSTGRES_USER=vigia_user
POSTGRES_PASSWORD=insert_secure_password_here

# Usados por el Backend para conectarse a la DB.
# En local, docker-compose los arma a partir de POSTGRES_* (DB_HOST=db);
# DB_PORT sí se usa: es el puerto de la DB expuesto en el host.
# En Railway: usar las variables provistas por el plugin de Postgres
# (ej: host interno, port, user, pass).
DB_HOST=db
DB_PORT=5432
DB_NAME=vigia
DB_USER=vigia_user
DB_PASSWORD=insert_secure_password_here

# --------------------------------------------------------------
# 2. RabbitMQ (Colas de Mensajería)
# --------------------------------------------------------------
# En local: docker-compose usa el contenedor rabbitmq con guest/guest
# (estas variables no se leen). En Railway: internal domain del servicio RabbitMQ.
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --------------------------------------------------------------
# 3. Servidor de Correos (SMTP)
# --------------------------------------------------------------
# En local: maildev/mailpit (puerto 1025)
# En Railway/Producción: credenciales de un SMTP real (SendGrid, AWS SES, Gmail, etc).
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USER=user
MAIL_PASSWORD=pass

# --------------------------------------------------------------
# 4. Microservicios de Machine Learning
# --------------------------------------------------------------
# Puertos para desarrollo local (host)
ML_CELO_PORT=8001
ML_SALUD_PORT=8002
ML_GEO_PORT=8003

# URLs de los microservicios (usados por el Backend API y el Worker)
# En local, docker-compose ya las fija a http://ml-celo:8001, etc.
# En Railway: URLs internas de Railway (ej: http://ml-celo.railway.internal:8001)
ML_CELO_URL=http://ml-celo:8001
ML_SALUD_URL=http://ml-salud:8002
ML_GEO_URL=http://ml-geo:8003

# Umbral de decisión del modelo LSTM de detección de celo (P(celo) > CELO_THRESHOLD).
# NO usar 0.5: con class_weight balanceado el umbral que maximiza F1 sobre la
# curva Precision-Recall de VALIDACIÓN es otro (ver run_summary.json de la
# corrida activa en ml-training/celo/models/.../run_summary.json, campo
# "best_threshold_f1"; el conjunto de prueba no interviene en su elección).
# Valor actual (modelo init44, split_seed=42 -- el desplegado, idéntico en
# las corridas 20260918_195223 y 20261027_105620 -- dataset con ruido GPS
# realista + moveState cuantizado a la cadencia real de heartbeat, 200
# animales/90 días, ver ml-training/celo/README.md sección 6): 0.947
CELO_THRESHOLD=0.947

# Umbral de aislamiento por defecto de ml-geo, en metros: distancia máxima entre
# dos animales para considerarlos parte del mismo grupo. El default de 100 m es
# del orden del diámetro de un rodeo en pastoreo. Cada establecimiento tiene su
# propio umbral, que el backend envía en el request; este valor solo se usa si
# no llega (ver ml-geo/README.md).
UMBRAL_AISLAMIENTO_METROS=100.0
# Antigüedad máxima (s) de la última posición de un animal para clasificarlo en ml-geo.
VIGENCIA_POSICION_S=1800

# --------------------------------------------------------------
# 5. Backend y Configuración General
# --------------------------------------------------------------
# Puertos expuestos en local
BACKEND_PORT=8080

# Perfil de Spring Boot (dev o prod)
SPRING_PROFILES_ACTIVE=dev

# Configuración de CORS para el Frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback

# Login con Google (OAuth2 / SSO). Obligatorias: el backend-api no levanta sin
# ellas. Se sacan de Google Cloud Console > APIs y servicios > Credenciales
# (cliente OAuth "Aplicación web"). Nunca commitear los valores reales.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Horas sin señal de la caravana a partir de las cuales una alerta de celo
# pendiente se marca como "dato posiblemente desactualizado".
CELO_HORAS_DATO_DESACTUALIZADO=2

# Zona Horaria
TZ=America/Argentina/Buenos_Aires

# --------------------------------------------------------------
# 6. Backend Worker: ingesta y jobs de inferencia
# --------------------------------------------------------------
# API key del webhook de TTN (ingesta de telemetría). Tiene que coincidir con
# TTN_WEBHOOK_API_KEY de simulador/.env.
TTN_WEBHOOK_API_KEY=apiKey

# Frecuencia de cada job, en milisegundos.
VIGIA_BATCH_CELO_RATE=60000
VIGIA_BATCH_SALUD_RATE=60000
# Cohesión/aislamiento (ml-geo): solo consulta si llegó telemetría nueva.
# Para pruebas manuales conviene 60000 (1 min).
VIGIA_BATCH_GEO_RATE=900000

# Detector de anestro: cron de Spring (seg min hora día mes día-semana, hora
# argentina) y días sin celo para considerar anestro. Acá cada minuto (demo);
# en producción no se define y vale el default del código: "0 0 2 * * *"
# (todos los días a las 2 AM).
VIGIA_BATCH_ANESTRO_CRON=0 * * * * *
VIGIA_BATCH_ANESTRO_SILENCIO_DIAS=21

# Salud: días de calibración del perfil de referencia y cada cuánto se recalibra.
VIGIA_SALUD_CALIBRACION_DIAS=7
VIGIA_SALUD_RECALIBRACION_DIAS=30

# Cohesión/aislamiento: horas de posiciones que se mandan a ml-geo en cada
# análisis (para pruebas con el simulador conviene 1) y minutos seguidos fuera
# del grupo antes de abrir un aislamiento.
VIGIA_GEO_VENTANA_HORAS=24
VIGIA_GEO_MINUTOS_FUERA_MINIMO=15
VIGIA_GEO_HORAS_SIN_DATOS_CIERRE=6
