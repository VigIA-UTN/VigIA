# ==============================================================
# CONFIGURACIÓN DE ENTORNO - VigIA
# ==============================================================
# Utilizar este archivo como plantilla para el entorno local y 
# para configurar las variables en producción (Ej: Railway).
# NUNCA commitear contraseñas reales de producción.
# ==============================================================

# --------------------------------------------------------------
# 1. Base de Datos (PostgreSQL / TimescaleDB)
# --------------------------------------------------------------
# En local: valores por defecto para iniciar el contenedor de DB.
POSTGRES_DB=vigia
POSTGRES_USER=vigia_user
POSTGRES_PASSWORD=insert_secure_password_here

# Usados por el Backend para conectarse a la DB.
# En Railway: usar las variables provistas por el plugin de Postgres 
# (ej: host interno, port, user, pass).
DB_HOST=db
DB_PORT=5432
DB_NAME=vigia
DB_USER=vigia_user
DB_PASSWORD=insert_secure_password_here

# --------------------------------------------------------------
# 2. RabbitMQ (Colas de Mensajería)
# --------------------------------------------------------------
# En local: rabbitmq
# En Railway: internal domain del servicio RabbitMQ.
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --------------------------------------------------------------
# 3. Servidor de Correos (SMTP)
# --------------------------------------------------------------
# En local: maildev/mailpit (puerto 1025)
# En Railway/Producción: credenciales de un SMTP real (SendGrid, AWS SES, Gmail, etc).
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USER=user
MAIL_PASSWORD=pass

# --------------------------------------------------------------
# 4. Microservicios de Machine Learning
# --------------------------------------------------------------
# Puertos para desarrollo local (host)
ML_CELO_PORT=8001
ML_SALUD_PORT=8002
ML_GEO_PORT=8003

# URLs de los microservicios (usados por el Backend Worker)
# En local: http://ml-celo:8001, etc.
# En Railway: URLs internas de Railway (ej: http://ml-celo.railway.internal:8001)
ML_CELO_URL=http://ml-celo:8001
ML_SALUD_URL=http://ml-salud:8002
ML_GEO_URL=http://ml-geo:8003

# Umbral de decisión del modelo LSTM de detección de celo (P(celo) > CELO_THRESHOLD).
# NO usar 0.5: con class_weight balanceado el umbral que maximiza F1 sobre la
# curva Precision-Recall es otro (ver run_summary.json de la corrida activa en
# ml-training/celo/models/.../run_summary.json, campo "best_threshold_f1").
# Valor actual (corrida init44, split_seed=42, run 20260918_195223 --
# dataset regenerado con ruido GPS realista + moveState cuantizado a la
# cadencia real de heartbeat, 200 animales/90 días para una evaluación
# estadísticamente más confiable, ver ml-training/celo/README.md sección 3): 0.943
CELO_THRESHOLD=0.943

# Distancia al centroide del resto del rodeo, en metros, a partir de la cual
# ml-geo considera que un animal quedó aislado (alerta_aislamiento = true).
# El default de 100 m es del orden del diámetro de un rodeo en pastoreo: más
# lejos que eso el animal dejó de seguir al grupo. Es un único valor para todos
# los establecimientos; hacerlo configurable por campo es una HU pendiente.
UMBRAL_AISLAMIENTO_METROS=100.0

# --------------------------------------------------------------
# 5. Backend y Configuración General
# --------------------------------------------------------------
# Puertos expuestos en local
BACKEND_PORT=8080

# Perfil de Spring Boot (dev o prod)
SPRING_PROFILES_ACTIVE=dev

# Configuración de CORS para el Frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback

# Zona Horaria
TZ=America/Argentina/Buenos_Aires
