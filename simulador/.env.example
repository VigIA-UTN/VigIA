# URL del backend worker al que se enviará la telemetría
API_URL=http://localhost:8081/api/v1/ingesta/uplink

# Segundos entre envíos. Si se define acá, pisa el default de TODOS los scripts:
# 300 en simulador.py y simulador_normal.py (cadencia real de la caravana) y 5 en
# simulador_celo.py, simulador_celo_demo.py, simulador_cohesion.py y simulador_demo.py.
# simulador_cohesion.py acepta además --intervalo, que tiene prioridad.
# INTERVALO_SEGUNDOS=300

# Cantidad de caravanas correlativas (VIGIA-ARG-001..VIGIA-ARG-NNN) que simulan los scripts
NUM_ANIMALES=5

# Caravanas adicionales a simular (separadas por coma), ej. caravanas libres vinculadas recientemente
EXTRA_DEVICE_IDS=VIGIA-LIBRE-301,VIGIA-LIBRE-302,VIGIA-LIBRE-303,VIGIA-LIBRE-304,VIGIA-LIBRE-305

# [Acto 1, Paso 1.6] Cada cuántos segundos simulador_demo.py consulta el backend para
# detectar caravanas VIGIA-LIBRE-* que fueron vinculadas a nuevas vacas en vivo.
# Default 30 s. Bajar a 10 para reacción más inmediata durante la demo.
# INTERVALO_DESCUBRIMIENTO_SEGUNDOS=30

# API key del webhook de TTN: tiene que coincidir con TTN_WEBHOOK_API_KEY de infra/.env.
TTN_WEBHOOK_API_KEY=apiKey

# Caravana con patrón de celo forzado (simulador.py, simulador_normal.py,
# simulador_celo.py, simulador_celo_demo.py y simulador_demo.py) y con enfermedad
# forzada (simulador.py y simulador_demo.py).
FORZAR_CELO_DEVICE_ID=VIGIA-ARG-001
FORZAR_SALUD_DEVICE_ID=VIGIA-ARG-002

# Solo simulador_demo.py: "true" para inyectar historial y forzar el escenario sanitario.
INYECTAR_HISTORIAL_SALUD=false
