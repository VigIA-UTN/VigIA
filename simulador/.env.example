# URL del backend worker al que se enviará la telemetría
API_URL=http://localhost:8081/api/v1/ingesta/uplink

# Segundos entre envíos. Si se define acá, pisa el default (5) de simulador.py,
# simulador_celo.py y simulador_cohesion.py. Con 300 es la cadencia real de una caravana.
# simulador_cohesion.py acepta además --intervalo, que tiene prioridad.
# simulador_fuga.py y simulador_salud.py no lo leen (usan --intervalo, default 3 y 5).
# Para la demo dejarlo comentado: con 300, el script de celo del Acto 2 manda un punto cada 5 min.
# INTERVALO_SEGUNDOS=300

# Rodeo vivo de la demo: las vacas que mueve simulador.py (y contra las que
# simulador_salud.py mide el aislamiento de la #208). Default: VIGIA-ARG-015..026,
# gestantes sin rol especial que el seed deja agrupadas. Si se cambia, elegir vacas
# del Lote Principal sin rol en el seed y que DataInitializer deje en el rodeo.
# RODEO_DEVICE_IDS=VIGIA-ARG-015,VIGIA-ARG-016,VIGIA-ARG-017,VIGIA-ARG-018,VIGIA-ARG-019,VIGIA-ARG-020,VIGIA-ARG-021,VIGIA-ARG-022,VIGIA-ARG-023,VIGIA-ARG-024,VIGIA-ARG-025,VIGIA-ARG-026

# Caravanas adicionales a simular (separadas por coma). En simulador.py el default
# son estas mismas: las caravanas libres del Acto 1 (Paso 1.6). El worker las ignora
# hasta que se vinculan a una vaca desde la UI.
EXTRA_DEVICE_IDS=VIGIA-LIBRE-301,VIGIA-LIBRE-302,VIGIA-LIBRE-303,VIGIA-LIBRE-304,VIGIA-LIBRE-305

# API key del webhook de TTN: tiene que coincidir con TTN_WEBHOOK_API_KEY de infra/.env.
TTN_WEBHOOK_API_KEY=apiKey

# [Acto 2] Vaca con patrón de celo forzado (simulador_celo.py).
# simulador.py nunca le manda telemetría.
FORZAR_CELO_DEVICE_ID=VIGIA-ARG-001

# [Acto 4] Vaca con desvío sanitario y aislamiento (simulador_salud.py).
# simulador.py nunca le manda telemetría.
FORZAR_SALUD_DEVICE_ID=VIGIA-ARG-002

# [Acto 3] Vacas que mueve simulador_fuga.py (fuga por el alambrado norte).
# simulador.py nunca les manda telemetría.
FUGA_DEVICE_IDS=VIGIA-ARG-013,VIGIA-ARG-014
