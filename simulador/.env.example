# URL del backend worker al que se enviará la telemetría
API_URL=http://localhost:8081/api/v1/ingesta/uplink

# Segundos entre envíos. Si se define acá, pisa el default de TODOS los scripts:
# 300 en simulador.py (cadencia real de la caravana) y 5 en simulador_demo.py,
# simulador_celo.py y simulador_cohesion.py.
# simulador_cohesion.py acepta además --intervalo, que tiene prioridad.
# simulador_fuga.py no lo lee (usa --intervalo, default 3).
# Para la demo dejarlo comentado: con 300, el script de celo del Acto 2 manda un punto cada 5 min.
# INTERVALO_SEGUNDOS=300

# Cantidad de caravanas correlativas (VIGIA-ARG-001..VIGIA-ARG-NNN) que simulan
# simulador.py y simulador_demo.py.
NUM_ANIMALES=5

# Caravanas adicionales a simular (separadas por coma). En simulador_demo.py el default
# son estas mismas: las caravanas libres del Acto 1 (Paso 1.6). El worker las ignora
# hasta que se vinculan a una vaca desde la UI.
EXTRA_DEVICE_IDS=VIGIA-LIBRE-301,VIGIA-LIBRE-302,VIGIA-LIBRE-303,VIGIA-LIBRE-304,VIGIA-LIBRE-305

# API key del webhook de TTN: tiene que coincidir con TTN_WEBHOOK_API_KEY de infra/.env.
TTN_WEBHOOK_API_KEY=apiKey

# [Acto 2] Vaca con patrón de celo forzado (simulador.py y simulador_celo.py).
# simulador_demo.py nunca le manda telemetría.
FORZAR_CELO_DEVICE_ID=VIGIA-ARG-001

# Vaca con desvío sanitario forzado (solo simulador.py).
FORZAR_SALUD_DEVICE_ID=VIGIA-ARG-002

# [Acto 3] Vacas que mueve simulador_fuga.py (fuga por el alambrado norte).
# simulador_demo.py nunca les manda telemetría.
FUGA_DEVICE_IDS=VIGIA-ARG-013,VIGIA-ARG-014
